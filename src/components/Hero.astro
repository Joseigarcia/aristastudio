---
---

<section class="hero">
  <div class="hero-bg">
    <div class="hero-slide hero-slide-1 active"></div>
    <div class="hero-slide hero-slide-2"></div>
    <div class="hero-slide hero-slide-3"></div>
  </div>
  <div class="hero-overlay"></div>
  <div class="hero-content container">
    <p class="hero-label reveal">Renderizado e Interiorismo</p>
    <h1 class="hero-title reveal reveal-delay-1">
      Transformamos ideas<br/>en espacios que <em>inspiran</em>
    </h1>
    <p class="hero-subtitle reveal reveal-delay-2">
      Renderizado arquitectónico hiperrealista y diseño de interiores
    </p>
    <div class="hero-actions reveal reveal-delay-3">
      <a href="#portafolio" class="btn">Ver Portafolio</a>
      <a href="#contacto" class="btn btn-outline">Contactanos</a>
    </div>
  </div>
  <div class="hero-scroll">
    <span>Scroll</span>
    <div class="hero-scroll-line"></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    min-height: 700px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    opacity: 0;
    transition: opacity 1.5s ease;
  }

  .hero-slide.active {
    opacity: 1;
  }

  .hero-slide-1 {
    background: linear-gradient(135deg, #e8e4df 0%, #d5cec5 50%, #e8e4df 100%);
  }

  .hero-slide-2 {
    background: linear-gradient(135deg, #d5cec5 0%, #e0dbd5 50%, #d5cec5 100%);
  }

  .hero-slide-3 {
    background: linear-gradient(135deg, #e0dbd5 0%, #e8e4df 50%, #d9d3cb 100%);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(249,248,246,0.4) 0%,
      rgba(249,248,246,0.1) 40%,
      rgba(249,248,246,0.5) 100%
    );
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding-top: 120px;
  }

  .hero-label {
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--acento);
    margin-bottom: 1.5rem;
    font-weight: 500;
  }

  .hero-title {
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
    color: var(--texto);
  }

  .hero-title em {
    font-style: italic;
    color: var(--acento);
  }

  .hero-subtitle {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--texto-secundario);
    max-width: 500px;
    margin-bottom: 2.5rem;
    font-weight: 300;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .hero-scroll {
    position: absolute;
    bottom: 3rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-scroll span {
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--texto-terciario);
  }

  .hero-scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, var(--acento), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.3; transform: scaleY(0.6); }
    50% { opacity: 1; transform: scaleY(1); }
  }

  @media (max-width: 768px) {
    .hero { min-height: 100vh; }
    .hero-content { padding-top: 100px; }
  }
</style>

<script>
  const slides = document.querySelectorAll('.hero-slide');
  let current = 0;

  setInterval(() => {
    slides[current].classList.remove('active');
    current = (current + 1) % slides.length;
    slides[current].classList.add('active');
  }, 5000);
</script>
