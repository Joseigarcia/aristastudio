---
import Lightbox from './Lightbox.astro';

const { projects } = Astro.props;

const interiores = projects.filter((p: any) => p.categoria === 'renders-interiores').reverse();
const exteriores = projects.filter((p: any) => p.categoria === 'renders-exteriores').reverse();
const interiorismo = projects.filter((p: any) => p.categoria === 'interiorismo').reverse();
---

<div id="gallery-modal" class="gallery-modal">
  <div class="gallery-backdrop"></div>
  <div class="gallery-panel">
    <div class="gallery-header">
      <h2 class="gallery-title">Galeria</h2>
      <button class="gallery-close" aria-label="Cerrar">&times;</button>
    </div>

    <div class="gallery-tabs">
      <button class="gallery-tab active" data-tab="interiores">Render Interior</button>
      <button class="gallery-tab" data-tab="exteriores">Render Exterior</button>
      <button class="gallery-tab" data-tab="interiorismo">Interiorismo</button>
    </div>

    <div class="gallery-body">
      <div class="gallery-section active" data-panel="interiores">
        {interiores.map((p: any) => (
          <button class="gallery-item" onclick={`window.openLightbox('${p.imagen}', '${p.titulo}')`}>
            <img src={p.imagen} alt={p.titulo} loading="lazy" />
            <span class="gallery-item-label">{p.titulo}</span>
          </button>
        ))}
      </div>

      <div class="gallery-section" data-panel="exteriores">
        {exteriores.map((p: any) => (
          <button class="gallery-item" onclick={`window.openLightbox('${p.imagen}', '${p.titulo}')`}>
            <img src={p.imagen} alt={p.titulo} loading="lazy" />
            <span class="gallery-item-label">{p.titulo}</span>
          </button>
        ))}
      </div>

      <div class="gallery-section" data-panel="interiorismo">
        {interiorismo.map((p: any) => (
          <button class="gallery-item" onclick={`window.openLightbox('${p.imagen}', '${p.titulo}')`}>
            <img src={p.imagen} alt={p.titulo} loading="lazy" />
            <span class="gallery-item-label">{p.titulo}</span>
          </button>
        ))}
      </div>
    </div>
  </div>
</div>

<Lightbox />

<style>
  .gallery-modal {
    position: fixed;
    inset: 0;
    z-index: 9000;
    display: flex;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .gallery-modal.open {
    opacity: 1;
    visibility: visible;
  }

  .gallery-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
  }

  .gallery-panel {
    position: relative;
    margin-left: auto;
    width: 85%;
    max-width: 900px;
    height: 100%;
    background: var(--bg);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
  }

  .gallery-modal.open .gallery-panel {
    transform: translateX(0);
  }

  .gallery-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 2rem;
    border-bottom: 1px solid var(--borde);
    flex-shrink: 0;
  }

  .gallery-title {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .gallery-close {
    background: none;
    border: none;
    font-size: 1.75rem;
    color: var(--texto-terciario);
    cursor: pointer;
    line-height: 1;
    padding: 0.25rem;
    transition: color 0.2s ease;
  }

  .gallery-close:hover {
    color: var(--texto);
  }

  .gallery-tabs {
    display: flex;
    gap: 0;
    padding: 0 2rem;
    border-bottom: 1px solid var(--borde);
    flex-shrink: 0;
  }

  .gallery-tab {
    background: none;
    border: none;
    font-family: var(--font-principal);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--texto-terciario);
    padding: 1rem 1.25rem;
    cursor: pointer;
    position: relative;
    transition: color 0.3s ease;
  }

  .gallery-tab::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--acento);
    transform: scaleX(0);
    transition: transform 0.3s ease;
  }

  .gallery-tab:hover {
    color: var(--texto);
  }

  .gallery-tab.active {
    color: var(--texto);
  }

  .gallery-tab.active::after {
    transform: scaleX(1);
  }

  .gallery-body {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem 2rem;
  }

  .gallery-section {
    display: none;
  }

  .gallery-section.active {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .gallery-item {
    position: relative;
    aspect-ratio: 16/10;
    overflow: hidden;
    cursor: pointer;
    border: none;
    padding: 0;
    background: none;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gallery-item:hover img {
    transform: scale(1.03);
  }

  .gallery-item-label {
    display: block;
    text-align: center;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--texto);
    padding: 0.75rem 0;
  }

  @media (max-width: 768px) {
    .gallery-panel {
      width: 100%;
    }
  }
</style>

<script>
  const modal = document.getElementById('gallery-modal');
  const backdrop = modal?.querySelector('.gallery-backdrop');
  const closeBtn = modal?.querySelector('.gallery-close');
  const tabs = modal?.querySelectorAll('.gallery-tab');
  const sections = modal?.querySelectorAll('.gallery-section');

  function closeModal() {
    modal?.classList.remove('open');
    document.body.style.overflow = '';
  }

  backdrop?.addEventListener('click', closeModal);
  closeBtn?.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.classList.contains('open')) closeModal();
  });

  tabs?.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      const target = tab.getAttribute('data-tab');
      sections?.forEach(s => {
        s.classList.remove('active');
        if (s.getAttribute('data-panel') === target) {
          s.classList.add('active');
        }
      });
    });
  });
</script>
